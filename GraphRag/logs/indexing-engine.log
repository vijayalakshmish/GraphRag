2026-10-26 09:08:00.0266 - DEBUG - graphrag.api.index - {'entities': [{'id': '4037ffa4-27fc-4eac-b848-561f9a5c236d', 'human_readable_id': 0, 'title': 'API GATEWAY', 'type': 'SYSTEM_COMPONENT', 'description': 'A component through which Service A calls Service B, responsible for routing requests and enforcing timeouts and rate limits', 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6'], 'frequency': 1, 'degree': 5}, {'id': 'c43b3790-b716-4e6b-adce-85cde3336e8f', 'human_readable_id': 1, 'title': 'RETRIES', 'type': 'METHOD', 'description': 'RETRIES is a resilience pattern and mechanism utilized to improve system reliability when transient failures occur. By attempting failed requests again, RETRIES helps mitigate temporary disruptions. However, if left uncontrolled, this mechanism can significantly increase traffic and system load, potentially amplifying existing outages for already overloaded dependencies.', 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6', 'ef75e67bdfe9901dc928e64a03606b1720a71a57c77a80cd9d7b2b6c36f703e7ce4663519ca697ab2b1a56aa9382cc7475738ca88ef06860df7b6c402d82a89c'], 'frequency': 2, 'degree': 8}, {'id': 'b8289355-b828-461a-b02a-1abb2b57e24f', 'human_readable_id': 2, 'title': 'EXPONENTIAL BACKOFF', 'type': 'METHOD', 'description': 'Exponential backoff is a resilience pattern used to space out retry attempts by progressively increasing the wait time between subsequent tries. Additionally, exponential backoff is often used alongside jitter to help reduce synchronized retry attempts across multiple clients, thereby preventing network congestion and server overload.', 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6', 'ef75e67bdfe9901dc928e64a03606b1720a71a57c77a80cd9d7b2b6c36f703e7ce4663519ca697ab2b1a56aa9382cc7475738ca88ef06860df7b6c402d82a89c'], 'frequency': 2, 'degree': 3}, {'id': '9793de56-2891-4d25-9e13-2692c46477f9', 'human_readable_id': 3, 'title': 'JITTER', 'type': 'METHOD', 'description': 'A technique used alongside exponential backoff to reduce synchronized retry attempts', 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6'], 'frequency': 1, 'degree': 2}, {'id': 'e631bf31-4687-4e3c-80c0-3b79b95a6463', 'human_readable_id': 4, 'title': 'CIRCUIT BREAKERS', 'type': 'TECHNOLOGY', 'description': 'A mechanism designed to prevent repeated calls to a failing dependency when the failure rate crosses a configured threshold', 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6'], 'frequency': 1, 'degree': 4}], 'relationships': [{'id': '60c1ad23-ac72-4c4e-9929-8438013baa1c', 'human_readable_id': 0, 'source': 'API GATEWAY', 'target': 'RETRIES', 'description': 'The API gateway handles request routing where techniques like retries and backoff are applied for reliability', 'weight': 5.0, 'combined_degree': 13, 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6']}, {'id': '5cd73cf5-ce78-4b12-bb03-36798efa74ad', 'human_readable_id': 1, 'source': 'RETRIES', 'target': 'EXPONENTIAL BACKOFF', 'description': 'Retries and exponential backoff are configured together as resilience patterns to enhance the reliability of systems. Specifically, exponential backoff is a method applied to retries to reduce synchronized retry attempts.', 'weight': 18.0, 'combined_degree': 11, 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6', 'ef75e67bdfe9901dc928e64a03606b1720a71a57c77a80cd9d7b2b6c36f703e7ce4663519ca697ab2b1a56aa9382cc7475738ca88ef06860df7b6c402d82a89c']}, {'id': 'c35afe6c-0dcb-4608-86bb-2057b7435283', 'human_readable_id': 2, 'source': 'RETRIES', 'target': 'JITTER', 'description': 'Jitter is used alongside exponential backoff to optimize retry attempts', 'weight': 9.0, 'combined_degree': 10, 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6']}, {'id': '9b1e538b-1184-4f2d-976d-8f8a03fa6ec1', 'human_readable_id': 3, 'source': 'CIRCUIT BREAKERS', 'target': 'FAILURE RATE', 'description': 'Circuit breakers trigger and prevent calls when the failure rate crosses a configured threshold', 'weight': 1.0, 'combined_degree': 6, 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6']}, {'id': '805671aa-c71a-4f0d-a9b9-b572443aa730', 'human_readable_id': 4, 'source': 'SERVICE A', 'target': 'API GATEWAY', 'description': 'Service A calls Service B through an API gateway', 'weight': 9.0, 'combined_degree': 6, 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6']}]}
