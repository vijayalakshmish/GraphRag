eadable_id': 2, 'community': 2, 'level': 0, 'parent': -1, 'children': [], 'title': 'Community 2', 'entity_ids': ['a3c6ae58-9231-41c8-b341-a4249fc9983e', 'c1491485-fafb-40e4-a5c0-dbf94d34608f'], 'relationship_ids': ['2ba088bd-3fb5-47d5-8603-c72f10f53843'], 'text_unit_ids': ['f3b271ceb34641ec5cf88318800a17bf3362564ce454940baa913c56c034c4b15b9bdbcc32018add04918d4d878dececd0f0216c2d2e7a70b5a58088546b63f0'], 'period': '2026-10-26', 'size': 2}, {'id': '0563bd85-d5cc-4597-90e3-eeee1aaedb3b', 'human_readable_id': 3, 'community': 3, 'level': 0, 'parent': -1, 'children': [], 'title': 'Community 3', 'entity_ids': ['5d8afe3b-d656-4c15-9078-dbef119cbed4', '9793de56-2891-4d25-9e13-2692c46477f9'], 'relationship_ids': ['701a8273-d116-4997-8643-068fe3509e0b'], 'text_unit_ids': ['b0ca2833340d32052483734b1b8da42c68a1c07301275a958e578d6f2c0fd975e493c187c9ff97eccc86068941a056a4823f2ae5c2bf0d4f3c3377d8d1840cc6'], 'period': '2026-10-26', 'size': 2}]
